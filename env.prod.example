# Settings for the SERVER. On the server, copy this file to .env (next to docker-compose.yml) and fill it in.
# Never commit the real .env. (Your Alpaca keys live separately, in backend/.env, as on your laptop.)

# Makes plain `docker compose ...` commands use both files on the server, so you never have to type -f twice.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The address of your site. With no domain name yet, use your server's Elastic IP with dashes + .sslip.io,
# e.g. for 34.240.12.7 ->  34-240-12-7.sslip.io  (a free service that points that name at that IP).
DOMAIN=34-240-12-7.sslip.io

# The database password: make up a long random one, e.g. run:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The site's login (until the app has real logins). Make the hash on the server with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes around the hash: it contains $ signs, which would otherwise be misread.
BASIC_AUTH_USER=sean
BASIC_AUTH_HASH='$2a$14$paste-the-hash-here'
